modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[userenv]

[userenv.shared]
TOMI_FOUNDER_EMAIL = "yustonnessybush@gmail.com"

[userenv.development]
TOMI_PREVIEW_SKIP_STRIPE_INIT = "1"
TOMI_HUMANITARIAN_TEST_AUTHORIZED = "true"
TOMI_PROFILE_REMINDER_FROM = "yuston@theonemovementinternational.ae"
TOMI_DAILY_PILOT = "development"

[userenv.production]
TOMI_PROFILE_REMINDER_FROM = "yuston@theonemovementinternational.ae"
TOMI_PUBLIC_SITE_URL = "https://theonemovementinternational.ae"

[objectStorage]
defaultBucketID = "replit-objstore-dff55171-2234-4344-b2ab-09e947c5c215"
